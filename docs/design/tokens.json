{
  "name": "Strategy Intelligence / live market",
  "version": "1.0.0",
  "source": "extracted from tradingagents/research/livepage.py and tradingagents/research/dashboard.py",
  "note": "Two themes on purpose: the evidence screens keep the report's paper theme, the live screens use the market theme. A live quote must never look like an evidence number.",
  "themes": {
    "evidence": {
      "ink": "#12161c",
      "paper": "#fbfaf7",
      "surface": "#ffffff",
      "muted": "#6b7280",
      "line": "#e3e0d8",
      "line-strong": "#c9c4b8",
      "accent": "#1f5f8b",
      "accent-press": "#17496b",
      "ok": "#1c6b46",
      "warn": "#8a5a00",
      "bad": "#8c2f2f",
      "wash-accent": "#eef4f9",
      "wash-ok": "#eaf5ee",
      "wash-warn": "#fbf2df",
      "wash-bad": "#f9ecec"
    },
    "market": {
      "stage": "#080c12",
      "stage-mid": "#0a1018",
      "stage-glow": "#16273a",
      "ink": "#e8eef6",
      "muted": "#8fa3b8",
      "hairline": "rgba(232,238,246,.14)",
      "live": "#7cf0b4",
      "sim": "#f6cd6b",
      "down": "#ff9d9d",
      "flat": "#8fa3b8"
    }
  },
  "series": ["#6cc6f5", "#f2b134", "#67d18a", "#e86a92", "#b28df0", "#4fd1c5"],
  "type": {
    "family": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, monospace",
    "scale": {
      "eyebrow": "11 / 700 / +0.14em / uppercase",
      "micro": "11 / 500 / +0.02em",
      "caption": "12 / 400",
      "body": "13 / 400",
      "body-lg": "15 / 400",
      "label": "13 / 600",
      "h3": "17 / 600",
      "h2": "20 / 600 / -0.01em",
      "h1": "27 / 600 / -0.015em",
      "display": "34 / 650 / -0.02em"
    }
  },
  "space": [4, 6, 8, 12, 16, 20, 24, 32, 48],
  "radius": { "xs": 4, "sm": 6, "md": 8, "lg": 12, "pill": 999 },
  "elevation": {
    "flat": "none",
    "card": "0 1px 2px rgba(18,22,28,.05)",
    "raised": "0 18px 40px -22px rgba(8,12,18,.8)"
  },
  "states": {
    "feed-quality": ["live", "delayed", "simulated", "unavailable"],
    "verdict": ["passed", "failed", "pending"],
    "version-status": ["Research", "Backtesting", "Validation", "Paper Testing", "Approved", "Rejected", "Rolled Back"],
    "no-trade": "NO TRADE is a result, not an error state. It always carries the gate that failed and the number that failed it."
  },
  "copy-rules": [
    "A delayed or simulated feed is never described as live; the word appears on the legend, the card, the table row and the API field.",
    "Numbers carry their unit: R for expectancy, % for drawdown, currency for PnL.",
    "An unreachable feed reports the error text, not a stale price.",
    "Every action that changes what the engine believes is CLI-only, and the UI says so in place."
  ]
}
